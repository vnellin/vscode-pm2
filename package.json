{
  "name": "pm2-status",
  "displayName": "PM2 Process Manager",
  "description": "Manage PM2 processes from VS Code status bar",
  "version": "1.1.0",
  "publisher": "pm2-status",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pm2-status.refresh",
        "title": "PM2: Refresh processes"
      },
      {
        "command": "pm2-status.start",
        "title": "PM2: Start process"
      },
      {
        "command": "pm2-status.stop",
        "title": "PM2: Stop process"
      },
      {
        "command": "pm2-status.restart",
        "title": "PM2: Restart process"
      },
      {
        "command": "pm2-status.logs",
        "title": "PM2: Show logs"
      }
    ],
    "configuration": {
      "title": "PM2 Process Manager",
      "properties": {
        "pm2-status.processNames": {
          "type": "array",
          "default": [],
          "description": "List of PM2 process names to monitor (required)"
        },
        "pm2-status.refreshInterval": {
          "type": "number",
          "default": 5000,
          "description": "Refresh interval in milliseconds"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "package": "vsce package",
    "package:major": "npm version major --no-git-tag-version && vsce package",
    "package:minor": "npm version minor --no-git-tag-version && vsce package",
    "package:patch": "npm version patch --no-git-tag-version && vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/vscode": "^1.110.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^10.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vnellin/pm2-status.git"
  }
}
